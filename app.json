{
  "expo": {
    "name": "RTMP Live Streamer",
    "slug": "streameryoutube3",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "rtmpstreamer",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0d0d0d"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.zainalzxc.rtmpstreamer",
      "infoPlist": {
        "NSCameraUsageDescription": "Kamera dibutuhkan untuk live streaming.",
        "NSMicrophoneUsageDescription": "Mikrofon dibutuhkan untuk audio live streaming."
      }
    },
    "android": {
      "package": "com.zainalzxc.rtmpstreamer",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#0d0d0d"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.INTERNET",
        "android.permission.READ_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-image-picker"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "76070b1a-d009-4822-96f1-df1a56ec91af"
      }
    }
  }
}
